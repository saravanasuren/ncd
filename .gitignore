# Both forms on purpose: the trailing slash matches only a DIRECTORY, so a
# SYMLINK named node_modules slipped past it and got committed (2026-07-29).
node_modules
node_modules/
dist/
build/
*.log
.env
.env.*
!.env.example
coverage/
.DS_Store
*.tsbuildinfo
web/dist/
api/dist/
packages/*/dist/

# runtime upload dir + PGlite dev DB (root `npm run dev` writes ./data, the
# api workspace writes ./api/data)
api/data/
/data/
.claude/worktrees/
