# No trailing slash: with `node_modules/` git ignores a DIRECTORY of that
# name but not a SYMLINK of that name, which is how a self-referential
# node_modules -> node_modules link reached main in #186 and broke every
# fresh checkout (nothing under it resolves).
node_modules
dist/
build/
*.log
.env
.env.*
!.env.example
coverage/
.DS_Store
*.tsbuildinfo
web/dist/
api/dist/
packages/*/dist/

# runtime upload dir + PGlite dev DB (root `npm run dev` writes ./data, the
# api workspace writes ./api/data)
api/data/
/data/
.claude/worktrees/
